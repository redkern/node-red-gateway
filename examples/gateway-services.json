[
  {
    "id": "services-comment",
    "type": "comment",
    "z": "services-flow",
    "name": "Configure Redis, TLS, account credentials, client, and API before deploying",
    "info": "Demonstrates event output, asynchronous results, a worker flow, an HTTP adapter, and Gateway metrics.",
    "x": 520,
    "y": 60,
    "wires": []
  },
  {
    "id": "services-flow",
    "type": "tab",
    "label": "Gateway Services Example",
    "disabled": false,
    "info": "",
    "env": []
  },
  {
    "id": "services-server",
    "type": "redkern-gateway-server-config",
    "name": "Gateway Server",
    "host": "0.0.0.0",
    "port": 7443,
    "redisMode": "standalone",
    "redisHost": "${REDIS_HOST}",
    "redisPort": 6379,
    "redisKeyPrefix": "node-red-gateway"
  },
  {
    "id": "services-account",
    "type": "redkern-gateway-account",
    "name": "Billing and reports",
    "server": "services-server",
    "accountName": "invoice-service",
    "operationPrefixes": "billing/*, reports/*"
  },
  {
    "id": "services-client",
    "type": "redkern-gateway-client-config",
    "name": "Central Gateway",
    "url": "wss://${GATEWAY_HOST}:${GATEWAY_PORT}",
    "podId": "${POD_ID}",
    "connectTimeoutMs": 10000,
    "deliveryMarginMs": 2000
  },
  {
    "id": "services-api",
    "type": "redkern-gateway-api-config",
    "name": "Billing API",
    "apiName": "billing-api",
    "url": "https://${API_HOST}/v1/invoices",
    "method": "GET",
    "tokenHeader": "Authorization",
    "timeoutMs": 30000,
    "maxResponseBytes": 262144,
    "rate": 0,
    "burst": 1
  },
  {
    "id": "services-event-inject",
    "type": "inject",
    "z": "services-flow",
    "name": "Publish invoice event",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"invoiceId\":\"INV-1001\"}",
    "payloadType": "json",
    "x": 160,
    "y": 180,
    "wires": [["services-out"]]
  },
  {
    "id": "services-out",
    "type": "redkern-gateway-out",
    "z": "services-flow",
    "name": "Invoice event",
    "client": "services-client",
    "operation": "billing/invoiceUpdated",
    "priority": "normal",
    "x": 410,
    "y": 180,
    "wires": []
  },
  {
    "id": "services-in",
    "type": "redkern-gateway-in",
    "z": "services-flow",
    "name": "Rebuild results",
    "client": "services-client",
    "operation": "billing/rebuild",
    "x": 180,
    "y": 300,
    "wires": [["services-async-debug"]]
  },
  {
    "id": "services-async-debug",
    "type": "debug",
    "z": "services-flow",
    "name": "Async result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "x": 430,
    "y": 300,
    "wires": []
  },
  {
    "id": "services-worker-in",
    "type": "redkern-gateway-worker-in",
    "z": "services-flow",
    "name": "Handle report rebuild",
    "server": "services-server",
    "operation": "reports/rebuild",
    "execTimeoutMs": 30000,
    "concurrency": 8,
    "retryClass": "idempotent",
    "maxDeliveries": 3,
    "x": 180,
    "y": 440,
    "wires": [["services-worker-result"]]
  },
  {
    "id": "services-worker-result",
    "type": "function",
    "z": "services-flow",
    "name": "Build worker response",
    "func": "msg.payload = { status: \"complete\", requestId: msg.redkern.gateway.requestId };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 440,
    "wires": [["services-worker-out"]]
  },
  {
    "id": "services-worker-out",
    "type": "redkern-gateway-worker-out",
    "z": "services-flow",
    "name": "Return report result",
    "server": "services-server",
    "operation": "reports/rebuild",
    "x": 680,
    "y": 440,
    "wires": []
  },
  {
    "id": "services-adapter",
    "type": "redkern-gateway-adapter",
    "z": "services-flow",
    "name": "Invoice HTTP adapter",
    "server": "services-server",
    "api": "services-api",
    "operation": "billing/fetchInvoice",
    "concurrency": 16,
    "queueTimeoutMs": 30000,
    "execTimeoutMs": 30000,
    "deadlineMs": 60000,
    "rate": 0,
    "burst": 1,
    "retryClass": "safe",
    "maxDeliveries": 3,
    "forwardIdempotencyKey": false,
    "x": 180,
    "y": 560,
    "wires": []
  },
  {
    "id": "services-metrics",
    "type": "redkern-gateway-metrics",
    "z": "services-flow",
    "name": "All Gateway metrics",
    "server": "services-server",
    "events": "",
    "x": 180,
    "y": 660,
    "wires": [["services-metrics-debug"]]
  },
  {
    "id": "services-metrics-debug",
    "type": "debug",
    "z": "services-flow",
    "name": "Metric events",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 430,
    "y": 660,
    "wires": []
  }
]
